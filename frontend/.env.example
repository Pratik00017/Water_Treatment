# Local browser development. Docker nginx already proxies /api to backend.
REACT_APP_API_URL=http://localhost:8000/api

# Optional future endpoints. Leave blank until the backend exposes them.
REACT_APP_LOGIN_ENDPOINT=
REACT_APP_SIGNUP_ENDPOINT=
REACT_APP_FORGOT_PASSWORD_ENDPOINT=
REACT_APP_ASSISTANT_ENDPOINT=
REACT_APP_HISTORY_ENDPOINT=
REACT_APP_REPORT_ENDPOINT=
REACT_APP_PROFILE_ENDPOINT=
REACT_APP_SETTINGS_ENDPOINT=
